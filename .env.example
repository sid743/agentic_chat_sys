#=====================================================================
# Agentic HR Platform - shared settings for LibreChat and the agent core
#
#   python scripts/setup_env.py      -> creates .env from this file and
#                                       fills in the generated secrets
#=====================================================================

#---------------------------------------------------------------------
# Model providers (fill in the ones you use)
#---------------------------------------------------------------------
# A real key lets BOTH LibreChat (direct chat) and the HR agents use the provider.
# "user_provided" = each LibreChat user types their own key in the UI
# (the HR agents cannot use those keys).
GROQ_API_KEY=user_provided
OPENAI_API_KEY=user_provided
# OPENAI_BASE_URL=https://api.openai.com/v1   # or an Azure/OpenAI-compatible gateway
OPENROUTER_API_KEY=
# Google Gemini, via its OpenAI-compatible endpoint. Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=user_provided

# Local model servers, as seen when running the agent core directly on your PC.
# docker-compose rewrites them to host.docker.internal for the containers.
OLLAMA_BASE_URL=http://localhost:11434/v1
LMSTUDIO_BASE_URL=http://localhost:1234/v1
VLLM_BASE_URL=http://localhost:8000/v1

#---------------------------------------------------------------------
# Agent core (Python multi-agent service)
#---------------------------------------------------------------------
# Shared secret LibreChat sends as a Bearer token (generated by setup_env.py)
AGENT_CORE_API_KEY=
# Model the agents use when "auto" is selected: <provider>/<model>
#   groq/qwen/qwen3.8-27b | gemini/gemini-3.1-flash-lite | openai/gpt-5-mini | ollama/llama3.1:8b | mock/hr-demo
#   (Groq ids contain a slash themselves, so the full id doubles up: groq/openai/gpt-oss-120b)
# Empty = first available of groq, gemini, openai, openrouter, ollama, lmstudio, vllm, mock
AGENT_DEFAULT_MODEL=
# Optional smaller/faster model just for routing, e.g. groq/openai/gpt-oss-20b
# Worth setting on Groq's free tier: rate limits are per model, so routing gets its own budget.
AGENT_ROUTER_MODEL=

# Map LibreChat login emails to demo employees (see /personas in the chat)
#   you@company.com=E1001;manager@company.com=E1005;hr@company.com=E1010
USER_EMPLOYEE_MAP=
DEFAULT_EMPLOYEE_ID=E1001
# Allow "/act-as E1005" in a conversation to switch persona (demo only)
ALLOW_ACT_AS=true
# Fixed "today" so the demo data (probation, accruals) stays meaningful. Empty = real date.
DEMO_TODAY=2026-09-17

# Retrieval (on-demand RAG)
#   hash      - offline, no downloads (default)
#   fastembed - local ONNX model; pip install fastembed; EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5
#   openai    - any OpenAI-compatible /embeddings API, e.g. Ollama:
#               EMBEDDINGS_BASE_URL=http://localhost:11434/v1  EMBEDDINGS_MODEL=nomic-embed-text
EMBEDDINGS_PROVIDER=hash
EMBEDDINGS_MODEL=
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
RAG_TOP_K=5
# QDRANT_URL=http://qdrant:6333    # empty = embedded Qdrant stored under core/var/qdrant
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/hr_demo   # empty = SQLite under core/var

# How the agent trace is shown: reasoning_content (LibreChat "Thoughts") | think | reasoning | none
REASONING_FIELD=reasoning_content
# minimal | normal | debug
TRACE_LEVEL=normal
ANSWER_FOOTER=true
MAX_AGENT_STEPS=6
LLM_TIMEOUT_SECONDS=90
LOG_LEVEL=INFO
LOG_JSON=false

#---------------------------------------------------------------------
# LibreChat  (https://www.librechat.ai/docs/configuration/dotenv)
#---------------------------------------------------------------------
HOST=0.0.0.0
PORT=3080
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080
NO_INDEX=true
TRUST_PROXY=1

APP_TITLE=Agentic HR Platform
CUSTOM_FOOTER=Agentic HR Platform - synthetic demo data, not a production HR system
# Built-in endpoints to show (custom endpoints from librechat.yaml are always shown)
ENDPOINTS=custom,openAI,agents

#---------------------------------------------------------------------
# Demo front door (gateway)
#---------------------------------------------------------------------
# A small proxy in front of LibreChat: signs this account in automatically so
# visitors land straight in a chat, and serves the icons in deploy/brand.
# Set GATEWAY_AUTO_LOGIN=false to get the normal login page back.
GATEWAY_AUTO_LOGIN=true
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_NAME=Demo User
# Generated by setup_env.py; create the account with:
#   docker compose exec librechat npm run create-user -- <email> "<name>" <username> <password>
DEMO_USER_PASSWORD=
APP_DESCRIPTION=Agentic HR assistant - internal demo with synthetic data

ALLOW_EMAIL_LOGIN=true
# The gateway signs the demo user in; nobody needs to register.
ALLOW_REGISTRATION=false
ALLOW_SOCIAL_LOGIN=false
ALLOW_SOCIAL_REGISTRATION=false
ALLOW_PASSWORD_RESET=false
ALLOW_UNVERIFIED_EMAIL_LOGIN=true
SESSION_EXPIRY=1000 * 60 * 15
REFRESH_TOKEN_EXPIRY=(1000 * 60 * 60 * 24) * 7

SEARCH=true
MEILI_NO_ANALYTICS=true

# Generated by setup_env.py - keep them stable once users exist
CREDS_KEY=
CREDS_IV=
JWT_SECRET=
JWT_REFRESH_SECRET=
MEILI_MASTER_KEY=

DEBUG_LOGGING=true
DEBUG_CONSOLE=false
CONSOLE_JSON=false
